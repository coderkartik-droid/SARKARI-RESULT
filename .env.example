# Local development configuration. Copy this file to .env and fill in secrets.
# .env is ignored by Git and must never be committed.

# Django development secret. Generate a private key locally; do not share it.
DJANGO_SECRET_KEY=REPLACE_WITH_A_PRIVATE_DJANGO_SECRET_KEY

# manage.py uses config.settings.development, which sets DEBUG=True.
# DEBUG is not read from the environment. Production settings force DEBUG=False.

# Database
# ---------------------------------------------------------------------------
# Local development: leave DATABASE_URL unset. The project automatically uses
# the project-root db.sqlite3 file (see config/settings/base.py).
#
# Production: a single PostgreSQL connection URL. On Render this is injected
# automatically from the managed database (see render.yaml). Never commit or
# paste a real URL into this example file.
# DATABASE_URL=postgresql://user:REPLACE_WITH_YOUR_DATABASE_PASSWORD@host:5432/database_name
#
# Optional: seconds a persistent DB connection is reused (default 600).
# DB_CONN_MAX_AGE=600
#
# Optional: PostgreSQL SSL mode override. Defaults to "require" (connection is
# encrypted, but the CA chain is not verified). Set to "verify-full" to
# enforce full certificate validation.
# DB_SSLMODE=require
#
# Production also requires (set these in the Render dashboard, not here):
# DJANGO_SECRET_KEY=<a unique random key of at least 50 characters>
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# On Render the service's *.onrender.com hostname is trusted automatically.
#
# Legacy split database settings remain supported when DATABASE_URL is unset:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
# DB_HOST=your_database_host
# DB_PORT=5432

# Optional site configuration:
# CMS_MAX_IMAGE_SIZE=5242880
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PORTAL_INSTAGRAM_URL=https://www.instagram.com/your-account/
# PORTAL_FACEBOOK_URL=https://www.facebook.com/your-page/
# PORTAL_YOUTUBE_URL=https://www.youtube.com/@your-channel

# AI Provider configuration. Supported providers: gemini, openai, openrouter, grok.
# Each provider's *_MODEL setting accepts a comma-separated allowlist.
# Multiple accounts per provider are supported: repeat the *_API_KEY / *_MODEL
# pair once per account. Every repeated block is registered as its own
# configuration (shown as "account N" in the model selector), so repeating a
# provider does not overwrite the previous account.
# Restart the Django server after changing these values.
# Gemini: get key from https://aistudio.google.com/
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# OpenAI: get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# OpenRouter: get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b-20260604

# Grok: get key from https://console.x.ai/
GROK_API_KEY=PASTE_YOUR_GROK_API_KEY_HERE
GROK_MODEL=grok-4.7

AI_PROVIDER=gemini
AI_ENABLED=True
AI_RATE_LIMIT_PER_MINUTE=15

# Google OAuth credentials from Google Cloud Console.
# Local callback URI: http://localhost:8000/accounts/google/login/callback/
# IMPORTANT: You MUST add BOTH of these URLs to "Authorized redirect URIs" in Google Cloud Console:
#   - http://localhost:8000/accounts/google/login/callback/
#   - http://127.0.0.1:8000/accounts/google/login/callback/
# Also authorize http://127.0.0.1:8000/accounts/google/login/callback/ if using 127.0.0.1.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Gmail SMTP. Use your Gmail address and an App Password, not your normal
# account password. Keep EMAIL_USE_TLS=True and EMAIL_USE_SSL=False on port 587.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_GMAIL_ADDRESS@gmail.com
EMAIL_HOST_PASSWORD=PASTE_YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
PASSWORD_RESET_TIMEOUT=86400
